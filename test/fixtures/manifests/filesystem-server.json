{
  "server": "filesystem",
  "tools": [
    {
      "name": "read_file",
      "description": "Read the contents of a file at the given path.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": { "type": "string" }
        },
        "required": ["path"]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "write_file",
      "description": "Write content to a file at the given path, creating it if it does not exist.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "content": { "type": "string" }
        },
        "required": ["path", "content"]
      },
      "annotations": {
        "destructiveHint": true
      }
    }
  ]
}
